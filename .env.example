# Public URL / CSRF origin check
PUBLIC_ORIGIN=https://adams-erben.de

# Impressum / Verantwortlichkeit – vor Produktivsetzung zwingend ausfüllen
SITE_OPERATOR_NAME=
SITE_OPERATOR_ADDRESS=
SITE_OPERATOR_EMAIL=
SITE_OPERATOR_PHONE=
SITE_RESPONSIBLE_NAME=

# Optional provider details where applicable
SITE_OPERATOR_LEGAL_FORM=
SITE_OPERATOR_REPRESENTATIVE=
SITE_OPERATOR_REGISTER=
SITE_OPERATOR_REGISTER_NUMBER=
SITE_OPERATOR_VAT_ID=
SITE_OPERATOR_BUSINESS_ID=

# Hosting disclosure – production startup requires provider, address and retention disclosure
HOSTING_PROVIDER_NAME=Hetzner Online GmbH
HOSTING_PROVIDER_ADDRESS=Industriestr. 25, 91710 Gunzenhausen, Deutschland
HOSTING_LOG_RETENTION=

# SMTP – niemals echte Secrets committen
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@adams-erben.de
SMTP_FROM_NAME=Adams Erben
SMTP_PROVIDER_NAME=
SMTP_PROVIDER_ADDRESS=
SMTP_LOG_RETENTION=
SMTP_DPA_STATUS=
SMTP_TRANSFER_NOTE=

# Abuse protection: generate a long random value, e.g. openssl rand -hex 32
RATE_LIMIT_SALT=

# Contact governance: HMAC secret for private suppression identifiers.
# Use a separate random secret; do not reuse RATE_LIMIT_SALT.
CONTACT_SUPPRESSION_KEY=

# DRV data-use gate.
# Set to 1 only after the production use of the DRV directory/data has a documented legal/contractual basis.
DRV_DATA_USAGE_APPROVED=0

# DRV fallback; public organizational address
DRV_FALLBACK_EMAIL=info@rudern.de

# Website discovery / PoC B. Secret niemals committen.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
DISCOVERY_AUTO_ACCEPT_THRESHOLD=0.78
DISCOVERY_REVIEW_THRESHOLD=0.48

# Only for local API tests without browser Origin header
ALLOW_NO_ORIGIN=0
